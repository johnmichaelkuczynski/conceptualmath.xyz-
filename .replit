modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
build = ["sh", "-c", "CI=true pnpm install --frozen-lockfile"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[[deployment.responseHeaders]]
path = "/dashboard"
name = "X-Robots-Tag"
value = "noindex, follow"

[[deployment.responseHeaders]]
path = "/dashboard/*"
name = "X-Robots-Tag"
value = "noindex, follow"

[[deployment.responseHeaders]]
path = "/curriculum"
name = "X-Robots-Tag"
value = "noindex, follow"

[[deployment.responseHeaders]]
path = "/weeks/*"
name = "X-Robots-Tag"
value = "noindex, follow"

[[deployment.responseHeaders]]
path = "/assignments"
name = "X-Robots-Tag"
value = "noindex, follow"

[[deployment.responseHeaders]]
path = "/assignments/*"
name = "X-Robots-Tag"
value = "noindex, follow"

[[deployment.responseHeaders]]
path = "/analytics"
name = "X-Robots-Tag"
value = "noindex, follow"

[[deployment.responseHeaders]]
path = "/assessments"
name = "X-Robots-Tag"
value = "noindex, follow"

[[deployment.responseHeaders]]
path = "/assessments/*"
name = "X-Robots-Tag"
value = "noindex, follow"

[[deployment.responseHeaders]]
path = "/gradebook"
name = "X-Robots-Tag"
value = "noindex, follow"

[[deployment.responseHeaders]]
path = "/diagnostics"
name = "X-Robots-Tag"
value = "noindex, follow"

[[deployment.responseHeaders]]
path = "/lectures/*"
name = "X-Robots-Tag"
value = "noindex, follow"

[[deployment.responseHeaders]]
path = "/practice/*"
name = "X-Robots-Tag"
value = "noindex, follow"

[[deployment.responseHeaders]]
path = "/practice-runs/*"
name = "X-Robots-Tag"
value = "noindex, follow"

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 9099
externalPort = 3001

[[ports]]
localPort = 21586
externalPort = 3000

[[ports]]
localPort = 26272
externalPort = 3002

[nix]
channel = "stable-25_05"

[userenv]

[userenv.production]
CI = "true"

[userenv.shared]
SKIP_COURSE_SEED = "true"
